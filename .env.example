# =============================================================================
# Environment Variables Template (12-Factor: Factor III)
# =============================================================================
# Copy to .env and fill in values. NEVER commit .env to Git.
# =============================================================================

# ── Keycloak ──
KEYCLOAK_REALM=oidc-demo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=frontend-spa

# ── PostgreSQL ──
POSTGRES_PASSWORD=keycloak_dev_password

# ── Backend ──
LOG_LEVEL=DEBUG
ENVIRONMENT=dev

# ── Frontend (Vite env vars must start with VITE_) ──
# These are set in docker-compose.yml — listed here for reference
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=oidc-demo
# VITE_KEYCLOAK_CLIENT_ID=frontend-spa
# VITE_API_BASE_URL=http://localhost:8000
